/* 掌阅 ↔ Kavita 补丁  v__ZY_VER__
 *
 * 注入到 Kavita SPA。纯 vanilla JS, 不碰 Angular。
 *
 * v0.4.0 (2026-10-23): 加了**读书钩子** —— 进书自动 pull, 阅读中自动 push。
 *   - 进书 (/library/x/series/S/book/C) → POST /zy/api/auto/pull (掌阅→Kavita,
 *     只前进不回退); 位置真变了才 location.reload() 落到掌阅那页
 *   - 阅读中 Kavita 存进度 (POST api/reader/progress) → 去抖 8s 后 auto/push
 *     (Kavita→掌阅, push_decision 闸门照旧, 不会把掌阅往回拨)
 *   - 离开书 / 页面隐藏 → 立刻 flush 未发的 push (sendBeacon, token 走 query)
 *   开关和时延都在 patch.conf 的 AUTO_SYNC / AUTO_PUSH_DEBOUNCE / AUTO_PULL_GAP;
 *   前端启动先读 /zy/api/auto/cfg, 关掉就完全不挂钩子。
 *
 * v0.3.0 (2026-10-23): 入口挪到**两个**地方, 解决"看不到按钮"。
 *   - 顶栏 (navbar) 圆点+图标+文字按钮 —— 任何宽度都可见 (窄屏只留图标)
 *   - 左侧导航项 —— 打开侧边抽屉时的长文本入口
 * 两个入口都指向本机控制台 http://<当前主机>:__ZY_WEB_PORT__/,
 * 认证二维码 / 推拉 / 日志 / Kavita 改造全部在那边。
 *
 * v0.2.0 决定"不自建面板"仍然有效: 这里只做导航, 不做业务 UI。
 * 徽标只显示"补丁后端是否活着", 一眼看出控制台能不能连上。
 */
(function () {
  'use strict';

  var TOKEN = '__ZY_TOKEN__';
  var PORT   = __ZY_PORT__;
  var VER    = '__ZY_VER__';
  var BASE   = 'http://' + location.hostname + ':' + PORT + '/zy/api';
  var BASE_TRIED = 'direct-host-port';
  // 探测顺序:
  //   1) 同源反代 /zy/api → 后端。HTTPS 页面、跨网段、手机走域名时,
  //      直连 host:5111 会被混合内容/防火墙挡掉 —— 这是唯一还能通的路径。
  //   2) 直连 host:5111 (LAN + http 页面的老路)
  // 探测失败就保持 (2) 当默认, 后面请求自己失败 (会记进 note)。
  var BASE_CANDIDATES = [location.origin + '/zy/api'];
  if (location.protocol === 'http:') {
    BASE_CANDIDATES.push('http://' + location.hostname + ':' + PORT + '/zy/api');
  }
  var CONSOLE = 'http://' + location.hostname + ':__ZY_WEB_PORT__/';

  function _probe(url) {
    return new Promise(function (resolve) {
      var done = false;
      var ctrl = (typeof AbortController === 'function') ? new AbortController() : null;
      var timer = setTimeout(function () {
        if (done) return;
        done = true;
        if (ctrl) { try { ctrl.abort(); } catch (e) {} }
        resolve(false);
      }, 3000);
      var init = { headers: { 'X-ZY-Token': TOKEN } };
      if (ctrl) init.signal = ctrl.signal;
      fetch(url + '/health', init).then(function (r) {
        return r.json().catch(function () { return {}; }).then(function (j) {
          if (done) return;
          done = true; clearTimeout(timer);
          // 必须严格: Kavita 的 SPA 对未知路径也返回 200 + index.html,
          // 宽松判定会把 "没有反代" 误认为 "反代可用"。
          resolve(!!(r.ok && j && j.ok === true && typeof j.ts === 'number'));
        });
      }).catch(function () {
        if (done) return;
        done = true; clearTimeout(timer);
        resolve(false);
      });
    });
  }

  function resolveBase() {
    var chain = Promise.resolve(null);
    BASE_CANDIDATES.forEach(function (c) {
      chain = chain.then(function (found) {
        if (found) return found;
        return _probe(c).then(function (ok) { return ok ? c : null; });
      });
    });
    return chain.then(function (found) {
      if (found) { BASE = found; BASE_TRIED = found; }
      return BASE;
    });
  }

  // ---- 轻量工具 -------------------------------------------------------
  function el(tag, cls, txt) {
    var n = document.createElement(tag);
    if (cls) n.className = cls;
    if (txt != null) n.textContent = txt;
    return n;
  }
  function api(path) {
    return fetch(BASE + path, { headers: { 'X-ZY-Token': TOKEN } })
      .then(function (r) {
        return r.json().then(function (j) {
          if (!r.ok || j.ok === false) throw new Error(j.err || ('HTTP ' + r.status));
          return j;
        });
      });
  }

  // ---- 样式 (一次性注入) ---------------------------------------------
  var CSS = [
    '#zy-top-item{display:flex;align-items:center;}',
    '#zy-top-item .zy-top-btn{background:transparent;border:1px solid rgba(255,255,255,.18);',
    'color:inherit;border-radius:6px;padding:.25rem .5rem;display:inline-flex;',
    'align-items:center;gap:.4rem;cursor:pointer;font-size:.875rem;line-height:1.2;',
    'text-decoration:none;}',
    '#zy-top-item .zy-top-btn:hover{background:rgba(255,255,255,.12);}',
    '#zy-top-item .zy-dot{width:.45rem;height:.45rem;border-radius:50%;',
    'background:#9aa4ad;display:inline-block;}',
    '#zy-top-item.zy-ok .zy-dot{background:#4ac694;}',
    '#zy-top-item.zy-err .zy-dot{background:#BD362F;}',
    '@media (max-width:1200px){#zy-top-item .zy-top-lbl{display:none;}}',
    '#zy-nav-item{cursor:pointer;}',
    '#zy-nav-item .zy-badge{margin-left:auto;font-size:.7rem;padding:.1rem .4rem;border-radius:.6rem;',
    'background:var(--elevation-layer2);color:var(--text-muted-color);}',
    '#zy-nav-item.zy-ok .zy-badge{background:rgba(74,198,148,.2);color:#4ac694;}',
    '#zy-nav-item.zy-err .zy-badge{background:rgba(189,54,47,.25);color:#BD362F;}',
    // 自动同步的可见反馈 (只在真的动了位置/推成功时出现, 3.5s 自隐)
    '#zy-toast{position:fixed;right:1rem;bottom:1rem;z-index:99999;max-width:22rem;',
    'background:rgba(20,22,25,.94);color:#e8eaed;border:1px solid rgba(255,255,255,.14);',
    'border-radius:8px;padding:.6rem .8rem;font-size:.8rem;line-height:1.35;',
    'box-shadow:0 6px 24px rgba(0,0,0,.35);opacity:0;transform:translateY(8px);',
    'transition:opacity .18s,transform .18s;pointer-events:none;}',
    '#zy-toast.on{opacity:1;transform:none;}',
  ].join('');

  function injectCss() {
    if (document.getElementById('zy-patch-css')) return;
    var s = el('style');
    s.id = 'zy-patch-css';
    s.textContent = CSS;
    document.head.appendChild(s);
  }

  // ---- 后端探活 (只为徽标) -------------------------------------------
  var health = { state: 'unknown', books: null, err: '', base: '' };

  function probe() {
    return api('/health').then(function () {
      health.state = 'ok'; health.err = ''; health.base = BASE;
    }).catch(function (e) {
      health.state = 'off'; health.base = BASE;
      health.err = (e && e.message) ? e.message : 'unreachable';
      // 探活失败可能是 BASE 猜错了 (换了访问地址/端口映射变了) —— 重探一次候选,
      // 拿对了就立刻重试, 不要整页一直挂着"离线"。
      return resolveBase().then(function (base) {
        health.base = base;
        return api('/health').then(function () {
          health.state = 'ok'; health.err = ''; note('base 改走 ' + base);
        }).catch(function (e2) {
          health.err = (e2 && e2.message) ? e2.message : health.err;
        });
      }).catch(function () {});
    });
  }

  // ---- 顶栏按钮 (最显眼, 手机上也看得见) ------------------------------
  function mountTop() {
    if (document.getElementById('zy-top-item')) return true;
    var nav = document.querySelector('nav.navbar');
    if (!nav) return false;
    var box = el('div', 'nav-item');
    box.id = 'zy-top-item';
    var a = el('a', 'btn btn-icon zy-top-btn');
    a.href = CONSOLE;
    a.target = '_blank';
    a.rel = 'noopener';
    a.title = '掌阅同步 · 打开桥接控制台 (' + CONSOLE + ')';
    a.innerHTML =
      '<span class="zy-dot"></span>' +
      '<i class="fas fa-cloud-download-alt" aria-hidden="true"></i>' +
      '<span class="zy-top-lbl">掌阅同步</span>';
    box.appendChild(a);
    var anchor = nav.querySelector('app-download-queue-widget');
    if (anchor && anchor.parentNode === nav) nav.insertBefore(box, anchor);
    else {
      var c = nav.querySelector('.container-fluid');
      if (c) c.appendChild(box); else nav.appendChild(box);
    }
    return true;
  }

  // ---- 左侧导航入口 ---------------------------------------------------
  var NAV_AFTER = ['/bookmarks', '/want-to-read', '/lists', '/all-series'];
  var navInserted = false;

  function findNavAnchor() {
    var items = Array.prototype.slice.call(document.querySelectorAll('a.side-nav-item, a[href^="/"]'));
    for (var i = 0; i < items.length; i++) {
      var h = items[i].getAttribute('href') || '';
      if (NAV_AFTER.indexOf(h) >= 0) return items[i];
    }
    var all = document.querySelectorAll('.side-nav a[href]');
    return all.length ? all[all.length - 1] : null;
  }

  function makeNavItem() {
    var a = el('a', 'side-nav-item');
    a.id = 'zy-nav-item';
    a.href = CONSOLE;
    a.target = '_blank';
    a.rel = 'noopener';
    a.title = '在新标签打开掌阅桥接控制台';
    a.innerHTML =
      '<i class="fa fa-cloud-download" aria-hidden="true"></i>' +
      '<span>掌阅同步</span>' +
      '<span class="zy-badge" id="zy-nav-badge">…</span>';
    return a;
  }

  function mountNav() {
    if (navInserted && document.getElementById('zy-nav-item')) return true;
    var anchor = findNavAnchor();
    if (!anchor) return false;
    var old = document.getElementById('zy-nav-item');
    if (old) old.remove();
    anchor.parentNode.insertBefore(makeNavItem(), anchor.nextSibling);
    navInserted = true;
    return true;
  }

  function paintBadge() {
    var top = document.getElementById('zy-top-item');
    if (top) {
      top.classList.remove('zy-ok', 'zy-err');
      if (health.state === 'ok') top.classList.add('zy-ok');
      else if (health.state === 'off') top.classList.add('zy-err');
    }
    var b = document.getElementById('zy-nav-badge');
    var item = document.getElementById('zy-nav-item');
    if (!b || !item) return;
    item.classList.remove('zy-ok', 'zy-err');
    if (health.state === 'ok') {
      item.classList.add('zy-ok');
      b.textContent = health.books != null ? health.books + ' 本' : '就绪';
      b.title = '控制台: ' + CONSOLE;
    } else if (health.state === 'off') {
      item.classList.add('zy-err');
      b.textContent = '离线';
      b.title = '后端 ' + health.base + ' 没连上: ' + health.err
        + '  (浏览器控制台跑 __ZY__.auto() 看详情)';
      if (top) top.title = '掌阅同步后端不可达: ' + health.base + ' ' + health.err;
    } else {
      b.textContent = '…';
    }
  }

  // ---- 自动同步: 读书钩子 (v0.4.0) ------------------------------------
  // 语义对齐掌阅 App:
  //   进书            → pull (掌阅 -> Kavita, 只前进不回退, 位置变了才重载)
  //   阅读中存进度    → push (Kavita -> 掌阅, 去抖, push_decision 闸门防回退)
  //   离开书/页面隐藏 → 立刻 flush 未发出的 push
  var AUTO = { on: false, debounce: 8, gap: 120 };
  var READER_RE = /\/library\/\d+\/series\/(\d+)\/book\/\d+/;
  var SERIES_RE = /\/library\/\d+\/series\/(\d+)(?:\/|$)/;
  var rt = { reader: null, series: null };
  var pushTimers = {};
  var autoLog = [];

  function note(msg) {
    autoLog.push({ t: new Date().toISOString().slice(11, 19), m: msg });
    if (autoLog.length > 24) autoLog.shift();
  }

  // 右下角小提示: 只在真的同步了位置时弹, 否则用户永远不知道钩子在干活
  function toast(msg) {
    try {
      var n = document.getElementById('zy-toast');
      if (!n) { n = el('div'); n.id = 'zy-toast'; document.body.appendChild(n); }
      n.textContent = msg;
      n.classList.add('on');
      clearTimeout(toast._t);
      toast._t = setTimeout(function () { n.classList.remove('on'); }, 3500);
    } catch (e) {}
  }

  // 心跳: 让服务端 api.log 能证明"这个浏览器加载了哪一版钩子"
  var hbLast = { t: 0, key: '' };
  var saveCount = 0, pushCount = 0;
  function heartbeat(force) {
    var key = VER + ' ' + location.pathname;
    var now = Date.now();
    if (!force && key === hbLast.key && now - hbLast.t < 60000) return;
    if (force && now - hbLast.t < 5000) return;   // 强制也限 5s 一次
    hbLast = { t: now, key: key };
    var msgs = autoLog.slice(-6).map(function (x) { return x.m; });
    if (health.err) msgs.push('health: ' + health.err);
    apiPost('/auto/hb', {
      ver: VER, path: location.pathname, on: AUTO.on,
      saves: saveCount, pushes: pushCount, base: BASE_TRIED + (health.err ? ' !' + health.err : ''),
      msgs: msgs
    }).catch(function () {});
  }

  function apiPost(path, body, keepalive) {
    var init = {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-ZY-Token': TOKEN },
      body: JSON.stringify(body || {})
    };
    if (keepalive) init.keepalive = true;
    return fetch(BASE + path, init).then(function (r) {
      return r.json().catch(function () { return {}; });
    });
  }

  // pull: 掌阅 -> Kavita。allowReload=true 时位置真变了才重载到掌阅那页。
  function pullSeries(sid, allowReload) {
    if (!AUTO.on || !sid) return;
    var ck = 'zy_pull_' + sid;
    var now = Date.now();
    if (now - (+(sessionStorage.getItem(ck) || 0)) < AUTO.gap * 1000) return;
    try { sessionStorage.setItem(ck, String(now)); } catch (e) {}
    note('pull #' + sid + ' …');
    apiPost('/auto/pull', { series_id: sid }).then(function (j) {
      if (!j || j.ok === false) { note('pull #' + sid + ' busy'); return; }
      if (j.skipped) { note('pull #' + sid + ' ' + j.skipped); return; }
      note('pull #' + sid + ' ' + j.before + '->' + j.pages_read + '/' + j.pages);
      if (!j.changed) note('pull #' + sid + ' 掌阅没有更新');
      if (j.changed) {
        toast('已同步掌阅进度 ' + j.before + ' → ' + j.pages_read + '/' + j.pages);
      }
      if (!j.changed || !allowReload) return;
      var rk = 'zy_reload_' + sid;
      if (Date.now() - (+(sessionStorage.getItem(rk) || 0)) < 10000) return;
      try { sessionStorage.setItem(rk, String(Date.now())); } catch (e) {}
      note('pull #' + sid + ' 位置变了, 重载到掌阅位置');
      setTimeout(function () { location.reload(); }, 120);
    }).catch(function (e) { note('pull #' + sid + ' ERR ' + e.message); });
  }

  function pushNow(sid, quiet) {
    if (!AUTO.on || !sid) return;
    apiPost('/auto/push', { series_id: sid, tick: !!quiet }).then(function (j) {
      var d = (j && j.detail) || {};
      pushCount++;
      note('push #' + sid + ' +' + (d.pushed || 0) + ' ~' + (d.skipped || 0) +
           ' !' + (d.failed || 0) + (quiet ? ' (tick)' : ''));
      heartbeat(true);
      if (d.pushed > 0) {
        // 带上具体百分比 —— 用户看到数字才知道"真的推了"
        var p = null;
        var det = (j && j.detail && j.detail.detail) || [];
        for (var k = 0; k < det.length; k++) {
          if (det[k] && det[k].ok && det[k].pct != null) { p = det[k].pct; break; }
        }
        toast(p == null ? '进度已推送到掌阅'
                        : '已推送到掌阅 ' + (p * 100).toFixed(2) + '%');
      }
      else if (j && j.detail && j.detail.length) {
        var why = '';
        for (var i = 0; i < j.detail.length; i++) {
          if (j.detail[i] && j.detail[i].skipped) { why = String(j.detail[i].skipped); break; }
        }
        // 只有"回退被挡"值得说一声 —— 用户会以为"推了却没生效"
        if (why.indexOf('regress') === 0) {
          toast('掌阅进度更靠前，本次不回拨（Kavita 落后）');
        }
      }
    }).catch(function (e) { note('push #' + sid + ' ERR ' + e.message); });
  }

  // 去抖 + 最大等待: 连续翻页会不断重置计时器, 纯去抖在"读得快"时永远不触发。
  // 最大等待 30s —— 到点先推一次, 后面再按去抖来。
  // v0.4.5: 一轮阅读的**第一次**存进度快推 (3s) —— 手机切走/锁屏会冻结定时器,
  //         纯去抖在后台标签里可能整晚都不发。
  var PUSH_MAX_WAIT = 30;
  var PUSH_FAST = 3;          // 忙碌束的第一发, 秒
  var PUSH_FAST_GAP = 10;     // 两发快推之间至少隔 10s
  var pushFirst = {};
  var pushLastAt = {};

  function schedulePush(sid) {
    if (!AUTO.on || !sid) return;
    var now = Date.now();
    var burstStart = !pushTimers[sid];
    if (!pushFirst[sid]) pushFirst[sid] = now;
    if (pushTimers[sid]) clearTimeout(pushTimers[sid]);
    var wait = AUTO.debounce * 1000;
    if (now + wait - pushFirst[sid] >= PUSH_MAX_WAIT * 1000) wait = 0;
    if (burstStart && now - (pushLastAt[sid] || 0) > PUSH_FAST_GAP * 1000) {
      wait = Math.min(wait, PUSH_FAST * 1000);
    }
    pushTimers[sid] = setTimeout(function () {
      delete pushTimers[sid];
      pushFirst[sid] = 0;
      pushLastAt[sid] = Date.now();
      pushNow(sid);
    }, wait);
  }

  function flushPush(useBeacon) {
    Object.keys(pushTimers).forEach(function (sid) {
      clearTimeout(pushTimers[sid]);
      delete pushTimers[sid];
      if (useBeacon && navigator.sendBeacon) {
        try {
          navigator.sendBeacon(
            BASE + '/auto/push?token=' + encodeURIComponent(TOKEN),
            JSON.stringify({ series_id: +sid }));
          note('push #' + sid + ' beacon');
          return;
        } catch (e) { /* 落回普通请求 */ }
      }
      pushNow(+sid);
    });
  }

  function routeTick() {
    var p = location.pathname;
    var rm = READER_RE.exec(p);
    var rn = rm ? +rm[1] : null;
    var sm = SERIES_RE.exec(p);
    var sn = (!rn && sm) ? +sm[1] : null;

    if (rn !== rt.reader) {
      if (rt.reader) flushPush(false);        // 离开上一本, 尾巴先推掉
      rt.reader = rn;
      if (rn) pullSeries(rn, true);           // 进书: 取掌阅进度
      heartbeat(true);
    }
    if (sn !== rt.series) {
      rt.series = sn;
      if (sn) pullSeries(sn, false);          // 详情页: 只刷进度, 不重载
      heartbeat(true);
    }
  }

  // Kavita 保存阅读进度 = 一次 POST api/reader/progress。抓到它就排一次 push。
  function onReaderRequest(url, body) {
    if (!AUTO.on || !url) return;
    if (String(url).indexOf('reader/progress') < 0) return;
    var sid = null;
    try {
      if (typeof body === 'string') sid = +JSON.parse(body).seriesId || null;
      else if (body && typeof body === 'object') sid = +body.seriesId || null;
    } catch (e) {}
    if (!sid) {
      var m = READER_RE.exec(location.pathname);
      sid = m ? +m[1] : null;
    }
    if (sid) { saveCount++; note('save #' + sid); schedulePush(sid); heartbeat(true); }
  }

  function hookNetwork() {
    if (hookNetwork.done) return;
    hookNetwork.done = true;

    var OX = XMLHttpRequest.prototype.open;
    var OS = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.open = function (m, u) {
      this.__zyUrl = u;
      return OX.apply(this, arguments);
    };
    XMLHttpRequest.prototype.send = function (b) {
      try { onReaderRequest(this.__zyUrl, b); } catch (e) {}
      return OS.apply(this, arguments);
    };

    if (window.fetch && !window.fetch.__zyWrapped) {
      var OF = window.fetch;
      var WF = function (input, init) {
        try {
          var u = (typeof input === 'string') ? input : (input && input.url);
          if (init && typeof init.body === 'string') onReaderRequest(u, init.body);
        } catch (e) {}
        return OF.apply(this, arguments);
      };
      WF.__zyWrapped = true;
      window.fetch = WF;
    }

    var OPS = history.pushState;
    var ORS = history.replaceState;
    history.pushState = function () {
      var r = OPS.apply(this, arguments);
      setTimeout(routeTick, 60);
      return r;
    };
    history.replaceState = function () {
      var r = ORS.apply(this, arguments);
      setTimeout(routeTick, 60);
      return r;
    };
    window.addEventListener('popstate', function () { setTimeout(routeTick, 60); });
    window.addEventListener('pagehide', function () { flushPush(true); });
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'hidden') { flushPush(true); return; }
      // 回到前台: 后台标签的定时器可能被冻结过 —— 补一次探活/心跳/钩子自检
      probe().then(tick).catch(tick);
      if (!bootOk) autoBoot();
      if (AUTO.on) { heartbeat(true); routeTick(); }
    });
    setInterval(routeTick, 900);
    // 定时兜底 push: Kavita 的"存进度"并不覆盖所有位置变化 (滚动式 epub 只在
    // 特定时机存), 阅读中每 60s 兜一次。push_decision 会挡 noop / 回退, 不脏写。
    setInterval(function () {
      if (!AUTO.on || !rt.reader) return;
      if (document.visibilityState === 'hidden') return;
      pushNow(rt.reader, true);
    }, 60000);
    routeTick();
  }

  var bootTries = 0, bootOk = false;
  function autoBoot() {
    if (bootOk) return;
    bootTries++;
    resolveBase().then(function () {
      note('base ' + BASE);
      return api('/auto/cfg');
    }).then(function (j) {
      AUTO.on = !!j.enabled;
      AUTO.debounce = j.push_debounce_sec || 8;
      AUTO.gap = j.pull_gap_sec || 120;
      bootOk = true;
      if (AUTO.on) hookNetwork();
      note('auto ' + (AUTO.on ? 'on' : 'off'));
      heartbeat(true);   // 服务端据此确认"这一版钩子真的在跑"
    }).catch(function (e) {
      // 后端重启/网络抖动时 cfg 读不到 —— 不重试的话这一整页就永远没有钩子
      // (2026-10-24 事故: 页面在 5111 重启窗口加载, 读了整晚一次都没推)。
      // v0.4.5: 不再限 20 次, 退避封顶 60s, 页面重新可见时立刻再试一次。
      note('auto cfg 读取失败 ' + (e && e.message) + ' (第' + bootTries + '次)');
      heartbeat(true);
      var backoff = Math.min(60000, 15000 + bootTries * 5000);
      clearTimeout(autoBoot._t);
      autoBoot._t = setTimeout(autoBoot, backoff);
    });
  }

  // ---- 生命周期 -------------------------------------------------------
  function tick() {
    injectCss();
    mountTop();
    mountNav();
    paintBadge();
  }

  var mo = new MutationObserver(function () {
    clearTimeout(tick._t);
    tick._t = setTimeout(tick, 250);
  });

  function boot() {
    injectCss();
    var tries = 0;
    (function waitBody() {
      if (document.body) {
        mo.observe(document.body, { childList: true, subtree: true });
        tick();
        probe().then(function () {
          return api('/links').then(function (j) {
            health.books = (j.links || j.rows || []).length || 0;
          }).catch(function () {});
        }).then(tick).catch(tick);
        setInterval(tick, 15000);
        setInterval(function () { probe().then(tick).catch(tick); }, 30000);
        // 回到前台兜底 (钩子没装上时 hookNetwork 里的监听器根本不存在)
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState !== 'visible') return;
          if (!bootOk) autoBoot();
          probe().then(tick).catch(tick);
        });
        autoBoot();
        return;
      }
      if (tries++ > 60) return;
      setTimeout(waitBody, 250);
    })();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();

  // 调试口: 浏览器控制台执行 __ZY__.ver 可确认当前加载哪一版
  //         __ZY__.auto() 可看自动同步开关 + 最近 24 条动作
  window.__ZY__ = {
    api: api, health: health, console: CONSOLE, ver: VER, tick: tick,
    auto: function () {
      return { on: AUTO.on, reader: rt.reader, series: rt.series,
               debounce: AUTO.debounce, gap: AUTO.gap,
               base: BASE_TRIED, boot: bootTries, ok: bootOk,
               saves: saveCount, pushes: pushCount, log: autoLog.slice() };
    },
    pull: pullSeries, push: pushNow
  };
})();
