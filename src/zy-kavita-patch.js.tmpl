/* 掌阅 ↔ Kavita 补丁  v__ZY_VER__
 *
 * 注入到 Kavita SPA。纯 vanilla JS, 不碰 Angular。
 *
 * v0.4.0 (2026-10-23): 加了**读书钩子** —— 进书自动 pull, 阅读中自动 push。
 *   - 进书 (/library/x/series/S/book/C) → POST /zy/api/auto/pull (掌阅→Kavita,
 *     只前进不回退); 位置真变了才 location.reload() 落到掌阅那页
 *   - 阅读中 Kavita 存进度 (POST api/reader/progress) → 去抖 8s 后 auto/push
 *     (Kavita→掌阅, push_decision 闸门照旧, 不会把掌阅往回拨)
 *   - 离开书 / 页面隐藏 → 立刻 flush 未发的 push (sendBeacon, token 走 query)
 *   开关和时延都在 patch.conf 的 AUTO_SYNC / AUTO_PUSH_DEBOUNCE / AUTO_PULL_GAP;
 *   前端启动先读 /zy/api/auto/cfg, 关掉就完全不挂钩子。
 *
 * v0.3.0 (2026-10-23): 入口挪到**两个**地方, 解决"看不到按钮"。
 *   - 顶栏 (navbar) 圆点+图标+文字按钮 —— 任何宽度都可见 (窄屏只留图标)
 *   - 左侧导航项 —— 打开侧边抽屉时的长文本入口
 * 两个入口都指向本机控制台 http://<当前主机>:__ZY_WEB_PORT__/,
 * 认证二维码 / 推拉 / 日志 / Kavita 改造全部在那边。
 *
 * v0.2.0 决定"不自建面板"仍然有效: 这里只做导航, 不做业务 UI。
 * 徽标只显示"补丁后端是否活着", 一眼看出控制台能不能连上。
 */
(function () {
  'use strict';

  var TOKEN = '__ZY_TOKEN__';
  var PORT   = __ZY_PORT__;
  var WEBPORT = __ZY_WEB_PORT__;
  var VER    = '__ZY_VER__';
  var BASE   = 'http://' + location.hostname + ':' + PORT + '/zy/api';
  var BASE_TRIED = 'direct-host-port';
  // 探测顺序:
  //   1) 同源反代 /zy/api → 后端 (若有 nginx/Kestrel 层反代)
  //   2) 控制台端口 :WEBPORT/zy/api → 由 5012 反代到 5111 (2026-10-24 新增)
  //      好处: 只需要一个已映射的端口, 不必给 5111 单独做端口映射/放行。
  //   3) 直连 host:5111 (LAN + http 页面的老路)
  var BASE_CANDIDATES = [location.origin + '/zy/api'];
  if (location.protocol === 'http:') {
    BASE_CANDIDATES.push('http://' + location.hostname + ':' + WEBPORT + '/zy/api');
    BASE_CANDIDATES.push('http://' + location.hostname + ':' + PORT + '/zy/api');
  }
  var CONSOLE = 'http://' + location.hostname + ':' + WEBPORT + '/';

  function _probe(url) {
    return new Promise(function (resolve) {
      var done = false;
      var ctrl = (typeof AbortController === 'function') ? new AbortController() : null;
      var timer = setTimeout(function () {
        if (done) return;
        done = true;
        if (ctrl) { try { ctrl.abort(); } catch (e) {} }
        resolve(false);
      }, 3000);
      var init = { headers: { 'X-ZY-Token': TOKEN } };
      if (ctrl) init.signal = ctrl.signal;
      fetch(url + '/health', init).then(function (r) {
        return r.json().catch(function () { return {}; }).then(function (j) {
          if (done) return;
          done = true; clearTimeout(timer);
          // 必须严格: Kavita 的 SPA 对未知路径也返回 200 + index.html,
          // 宽松判定会把 "没有反代" 误认为 "反代可用"。
          resolve(!!(r.ok && j && j.ok === true && typeof j.ts === 'number'));
        });
      }).catch(function () {
        if (done) return;
        done = true; clearTimeout(timer);
        resolve(false);
      });
    });
  }

  function resolveBase() {
    var chain = Promise.resolve(null);
    BASE_CANDIDATES.forEach(function (c) {
      chain = chain.then(function (found) {
        if (found) return found;
        return _probe(c).then(function (ok) { return ok ? c : null; });
      });
    });
    return chain.then(function (found) {
      if (found) { BASE = found; BASE_TRIED = found; }
      return BASE;
    });
  }

  // ---- 轻量工具 -------------------------------------------------------
  function el(tag, cls, txt) {
    var n = document.createElement(tag);
    if (cls) n.className = cls;
    if (txt != null) n.textContent = txt;
    return n;
  }
  function api(path) {
    return fetch(BASE + path, { headers: { 'X-ZY-Token': TOKEN } })
      .then(function (r) {
        return r.json().then(function (j) {
          if (!r.ok || j.ok === false) throw new Error(j.err || ('HTTP ' + r.status));
          return j;
        });
      });
  }

  // ---- 阅读样式增强 (v0.4.7) -------------------------------------------
  // 5012 控制台「阅读样式增强」里配的规则 (行间距等) 由 /zy/api/reader-css
  // 渲染成 CSS, 这里注入 <style id="zy-reader-css">。
  // version 变了才重写; 保存后最迟 60s 生效 —— 不碰 Kavita 文件, 不重启容器。
  var RS = { ver: null, on: null, css: '', at: 0, err: '' };
  function applyReaderCss() {
    return fetch(BASE + '/reader-css', { headers: { 'X-ZY-Token': TOKEN } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (j) {
        if (!j || j.ok === false) return;
        if (j.version === RS.ver && !!j.enabled === RS.on) return;
        RS.ver = j.version; RS.on = !!j.enabled; RS.at = Date.now(); RS.err = '';
        var node = document.getElementById('zy-reader-css');
        var css = j.enabled ? (j.css || '') : '';
        RS.css = css;
        if (!css) {
          if (node && node.parentNode) node.parentNode.removeChild(node);
          return;
        }
        if (!node) { node = el('style'); node.id = 'zy-reader-css'; document.head.appendChild(node); }
        node.textContent = css;
      })
      .catch(function (e) { RS.err = (e && e.message) || 'fetch'; });
  }

  // ---- 关键词高亮 (2026-10-30) -----------------------------------------
  // 语料 = epub-refiner 导出的 keywords.json (按书自动匹配 / 在 5012 里显式绑定)。
  // 纯前端滤镜, 两条路:
  //   默认 highlight: CSS Custom Highlight API (Range + CSS.highlights) —— 一个字符
  //                  都不改 DOM, Kavita 存的进度/注解 XPath 完全不受影响。
  //   span (可配):   包 <span class="zy-kw zy-kw-<cat>">, 能做粗体/圆角, 但改 DOM。
  var KM = { sid: null, ver: null, mode: '', data: null, at: 0, err: '',
             ranges: 0, spans: 0, words: 0, cats: 0, file: '', hl: [],
             appliedAt: 0, skipped: '', busy: false, re: null, catOf: null,
             note: '' };

  function kmEsc(s) {
    return String(s).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  // 长词优先排序 + 拉丁词加边界, 避免 "fur coat" 被 "coat" 抢、或者 "Mum"
  // 命中 "Mummy"(mummy 自己是 alias 时仍能被单独匹配到)。
  function kmBuild(data) {
    var all = [];
    var catOf = {};
    (data.cats || []).forEach(function (c) {
      (c.words || []).forEach(function (w) {
        var low = String(w).toLowerCase();
        if (!low || catOf[low]) return;
        catOf[low] = c.id;
        all.push(String(w));
      });
    });
    all.sort(function (a, b) { return b.length - a.length; });
    var parts = all.map(function (w) {
      var pre = /^[0-9A-Za-z]/.test(w) ? '(?<![0-9A-Za-z])' : '';
      var suf = /[0-9A-Za-z]$/.test(w) ? '(?![0-9A-Za-z])' : '';
      return pre + kmEsc(w) + suf;
    });
    var re = null;
    try { re = new RegExp(parts.join('|'), 'gi'); } catch (e) { re = null; }
    KM.catOf = catOf;
    KM.re = re;
    KM.words = all.length;
    return re;
  }

  function kmCss(data, mode) {
    var out = ['/* zy-keyword-mark v' + (data.version || 0) + ' */'];
    (data.cats || []).forEach(function (c) {
      var st = c.style || {};
      var decl = [];
      if (st.bg) decl.push('background-color:' + st.bg);
      if (st.color) decl.push('color:' + st.color);
      if (st.underline) decl.push('text-decoration:underline');
      if (st.shadow) decl.push('text-shadow:' + st.shadow);
      if (!decl.length) return;
      if (mode === 'highlight') {
        out.push('::highlight(zy-kw-' + c.id + '){' + decl.join(';') + ';}');
      } else {
        var extra = [];
        if (st.bold) extra.push('font-weight:600');
        if (st.italic) extra.push('font-style:italic');
        if (st.radius) extra.push('border-radius:' + st.radius);
        if (st.pad) extra.push('padding:' + st.pad);
        out.push('.zy-kw-' + c.id + '{' + decl.concat(extra).join(';') + ';}');
      }
    });
    if (mode !== 'highlight') out.push('.zy-kw{box-decoration-break:clone;}');
    return out.length > 1 ? out.join('\n') : '';
  }

  function kmContainer() {
    return document.querySelector('.book-content')
        || document.querySelector('.book-content-container')
        || document.querySelector('.reader-content');
  }

  function kmClear() {
    if (window.CSS && window.CSS.highlights) {
      KM.hl.forEach(function (n) { try { window.CSS.highlights.delete(n); } catch (e) {} });
    }
    KM.hl = [];
    var sp = document.querySelectorAll('.book-content span.zy-kw, .zy-kw');
    for (var i = 0; i < sp.length; i++) {
      var e = sp[i];
      if (e.parentNode) {
        e.parentNode.replaceChild(document.createTextNode(e.textContent), e);
      }
    }
    if (sp.length) {
      var c = kmContainer();
      if (c) { try { c.normalize(); } catch (e2) {} }
    }
    KM.ranges = 0; KM.spans = 0;
  }

  function kmWalk(root, fn) {
    var w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode: function (n) {
        if (!n.nodeValue || !n.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
        var pa = n.parentNode;
        if (!pa) return NodeFilter.FILTER_REJECT;
        var tag = (pa.nodeName || '').toLowerCase();
        if (tag === 'script' || tag === 'style' || tag === 'svg') return NodeFilter.FILTER_REJECT;
        if (pa.classList && (pa.classList.contains('zy-kw') ||
            pa.classList.contains('zy-kw-span'))) return NodeFilter.FILTER_REJECT;
        return NodeFilter.FILTER_ACCEPT;
      }
    });
    var n;
    while ((n = w.nextNode())) fn(n);
  }

  function kmApplyHighlight(data) {
    var box = kmContainer();
    if (!box) { KM.skipped = 'no container'; return; }
    if ((box.textContent || '').length > 400000) { KM.skipped = 'too large'; return; }
    var per = {};
    kmWalk(box, function (node) {
      var txt = node.nodeValue;
      var re = KM.re;
      if (!re) return;
      re.lastIndex = 0;
      var m;
      while ((m = re.exec(txt))) {
        var hit = m[0];
        if (!hit) { re.lastIndex++; continue; }
        var cat = KM.catOf[hit.toLowerCase()];
        if (!cat) continue;
        var r = document.createRange();
        r.setStart(node, m.index);
        r.setEnd(node, m.index + hit.length);
        (per[cat] = per[cat] || []).push(r);
      }
    });
    if (window.CSS && window.CSS.highlights && typeof Highlight === 'function') {
      KM.hl.forEach(function (n) { try { window.CSS.highlights.delete(n); } catch (e) {} });
      KM.hl = [];
      KM.ranges = 0;
      Object.keys(per).forEach(function (cat) {
        var name = 'zy-kw-' + cat;
        try {
          var hl = new Highlight();
          per[cat].forEach(function (r) { hl.add(r); });
          hl.priority = 1;
          window.CSS.highlights.set(name, hl);
          KM.hl.push(name);
          KM.ranges += per[cat].length;
        } catch (e) { KM.err = 'hl: ' + ((e && e.message) || e); }
      });
    } else {
      // 老浏览器没有 Custom Highlight API → 就地降级成 span (只此一次提示)
      KM.note = 'CSS.highlights 不可用, 降级 span';
      kmApplySpan(data);
    }
  }

  function kmApplySpan(data) {
    var box = kmContainer();
    if (!box) { KM.skipped = 'no container'; return; }
    kmClear();
    var jobs = [];
    kmWalk(box, function (node) {
      var txt = node.nodeValue;
      var re = KM.re;
      if (!re) return;
      re.lastIndex = 0;
      var m, last = 0, frag = null;
      while ((m = re.exec(txt))) {
        var hit = m[0];
        if (!hit) { re.lastIndex++; continue; }
        var cat = KM.catOf[hit.toLowerCase()];
        if (!cat) continue;
        if (!frag) frag = document.createDocumentFragment();
        if (m.index > last) frag.appendChild(document.createTextNode(txt.slice(last, m.index)));
        var sp = document.createElement('span');
        sp.className = 'zy-kw zy-kw-' + cat;
        sp.textContent = hit;
        frag.appendChild(sp);
        last = m.index + hit.length;
        KM.spans++;
      }
      if (frag) {
        if (last < txt.length) frag.appendChild(document.createTextNode(txt.slice(last)));
        jobs.push([node, frag]);
      }
    });
    jobs.forEach(function (j) { if (j[0].parentNode) j[0].parentNode.replaceChild(j[1], j[0]); });
    KM.ranges = KM.spans;
  }

  function kmInjectCss(data, mode) {
    var css = kmCss(data, mode);
    var node = document.getElementById('zy-kw-css');
    if (!css) {
      if (node && node.parentNode) node.parentNode.removeChild(node);
      return;
    }
    if (!node) { node = el('style'); node.id = 'zy-kw-css'; document.head.appendChild(node); }
    node.textContent = css;
  }

  function kmApply(data) {
    if (!data || !data.enabled) {
      kmClear(); KM.cats = 0; KM.words = 0; KM.textLen = 0; KM.appliedAt = 0;
      return;
    }
    KM.busy = true;
    try {
      var mode = (data.mode === 'span') ? 'span' : 'highlight';
      if (mode === 'highlight' && !(window.CSS && window.CSS.highlights && typeof Highlight === 'function')) {
        mode = 'span';
      }
      KM.mode = mode;
      kmBuild(data);
      kmInjectCss(data, mode);
      kmClear();
      KM.cats = (data.cats || []).length;
      KM.textLen = kmContentLen();
      if (mode === 'highlight') kmApplyHighlight(data); else kmApplySpan(data);
      KM.appliedAt = Date.now();
      KM.skipped = '';
    } catch (e) {
      KM.err = (e && e.message) || String(e);
    } finally {
      KM.busy = false;
    }
  }

  function kmSync() {
    var sid = rt.reader || rt.series;
    if (!sid) {
      if (KM.sid) { kmClear(); KM.sid = null; KM.data = null; KM.ver = null; KM.cats = 0; KM.words = 0; }
      return Promise.resolve();
    }
    var url = BASE + '/keyword-mark?series=' + sid;
    return fetch(url, { headers: { 'X-ZY-Token': TOKEN } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (j) {
        if (!j || j.ok === false) { KM.err = (j && j.error) || 'bad payload'; return; }
        KM.err = '';
        KM.sid = sid;
        KM.file = j.file || '';
        var same = (KM.ver === j.version && KM.data && KM.data.mode === j.mode);
        KM.data = j;
        KM.ver = j.version;
        // 配置没变 + 上次真铺上了 → 不用重来。注意"上次铺上"要用命中数判断:
        // 正文还没渲染时也会 apply 一次 (0 命中), 那种不能算数。
        if (same && KM.appliedAt && (KM.ranges > 0 || !j.enabled || !j.total)) {
          kmWatch();
          return;
        }
        kmApplyWhenReady(j);
      })
      .catch(function (e) { KM.err = (e && e.message) || 'fetch'; });
  }

  // 阅读器正文是 Angular 后渲染的: apply 要等 .book-content 有内容,
  // 否则空走一趟 (0 命中), 之后没人再触发 (旧 bug)。
  function kmContentLen() {
    var b = kmContainer();
    return b ? (b.textContent || '').length : 0;
  }

  function kmApplyWhenReady(data, tries) {
    tries = (tries == null) ? 24 : tries;
    if (kmContentLen() > 200 || tries <= 0) {
      kmApply(data);
      kmWatch();
      return;
    }
    setTimeout(function () { kmApplyWhenReady(data, tries - 1); }, 300);
  }

  // 正文被 Angular 换掉 (翻页/换章) 后要重铺 —— 只在阅读页挂着看
  var kmMo = null;
  function kmWatch() {
    var box = kmContainer();
    if (!box) return;
    if (kmMo && kmMo._box === box) return;
    if (kmMo) { try { kmMo.disconnect(); } catch (e) {} }
    kmMo = new MutationObserver(function () {
      if (KM.busy || !KM.data || !KM.data.enabled) return;
      // 自己包 span 也会触发 mutation, 但正文长度不变 → 用长度挡住自激循环
      if (kmContentLen() === KM.textLen) return;
      clearTimeout(kmWatch._t);
      kmWatch._t = setTimeout(function () { if (!KM.busy) kmApply(KM.data); }, 400);
    });
    kmMo._box = box;
    kmMo.observe(box, { childList: true, subtree: true });
  }


  // ---- 样式 (一次性注入) ---------------------------------------------
  var CSS = [
    '#zy-top-item{display:flex;align-items:center;}',
    '#zy-top-item .zy-top-btn{background:transparent;border:1px solid rgba(255,255,255,.18);',
    'color:inherit;border-radius:6px;padding:.25rem .5rem;display:inline-flex;',
    'align-items:center;gap:.4rem;cursor:pointer;font-size:.875rem;line-height:1.2;',
    'text-decoration:none;}',
    '#zy-top-item .zy-top-btn:hover{background:rgba(255,255,255,.12);}',
    '#zy-top-item .zy-dot{width:.45rem;height:.45rem;border-radius:50%;',
    'background:#9aa4ad;display:inline-block;}',
    '#zy-top-item.zy-ok .zy-dot{background:#4ac694;}',
    '#zy-top-item.zy-err .zy-dot{background:#BD362F;}',
    '@media (max-width:1200px){#zy-top-item .zy-top-lbl{display:none;}}',
    '#zy-nav-item{cursor:pointer;}',
    '#zy-nav-item .zy-badge{margin-left:auto;font-size:.7rem;padding:.1rem .4rem;border-radius:.6rem;',
    'background:var(--elevation-layer2);color:var(--text-muted-color);}',
    '#zy-nav-item.zy-ok .zy-badge{background:rgba(74,198,148,.2);color:#4ac694;}',
    '#zy-nav-item.zy-err .zy-badge{background:rgba(189,54,47,.25);color:#BD362F;}',
    // 自动同步的反馈 (默认静默, 只在失败时出现; 3.5s 自隐)
    // 2026-10-26 用户: 淡入淡出 + 半透明黑底; 平时不要弹, 失败才提示
    '#zy-toast{position:fixed;right:1rem;bottom:1rem;z-index:99999;max-width:22rem;',
    'background:rgba(0,0,0,.5);color:#e8eaed;border:1px solid rgba(255,255,255,.07);',
    'border-radius:8px;padding:.5rem .75rem;font-size:.78rem;line-height:1.35;',
    'box-shadow:0 2px 10px rgba(0,0,0,.18);opacity:0;transform:translateY(4px);',
    'transition:opacity .3s ease,transform .3s ease;pointer-events:none;',
    'backdrop-filter:blur(2px);}',
    // 失败态: 只加一道暗红描边, 底色仍是半透明黑 (保持低调)
    '#zy-toast.err{border-color:rgba(189,54,47,.55);color:#f0d9d7;',
    'box-shadow:0 0 0 1px rgba(189,54,47,.28),0 2px 10px rgba(0,0,0,.18);}',
    '#zy-toast.on{opacity:1;transform:none;}',
    // 阅读器右下角: 上次 push 到掌阅的时间 (v0.4.11)。故意压低存在感 ——
    // 小字、灰色、不可点、不吃鼠标事件。
    '#zy-push-stamp{position:fixed;right:.6rem;bottom:.3rem;z-index:9998;',
    'font-size:.68rem;line-height:1.2;color:rgba(128,134,140,.78);',
    'pointer-events:none;user-select:none;white-space:nowrap;',
    'font-variant-numeric:tabular-nums;}',
    '@media (max-width:600px){#zy-push-stamp{font-size:.62rem;right:.4rem;bottom:.15rem;}}',
    // ---- 书签图标 (v0.4.16) -------------------------------------------
    // Kavita 在漫画阅读器里给每张 <img> 追加一个 div.bookmark-overlay,
    // 位置是"注入那一刻"按 left/top 算死的, 而且底边比图片低 10px;
    // 我们的 JS 归位要等 120ms + 一次 MutationObserver 抖动 →
    // 实际观感是"图标先在页面外露出来, 再跳回页角"。
    // 纯 CSS 覆盖: 元素一插入就由浏览器算位置, 没有中间态。
    '.bookmark-overlay{position:absolute !important;left:auto !important;top:auto !important;',
    'right:4px !important;bottom:4px !important;margin:0 !important;}',
    '.kavita-scale-width-container{position:relative;}',
  ].join('');

  function injectCss() {
    if (document.getElementById('zy-patch-css')) return;
    var s = el('style');
    s.id = 'zy-patch-css';
    s.textContent = CSS;
    document.head.appendChild(s);
  }

  // ---- 后端探活 (只为徽标) -------------------------------------------
  var health = { state: 'unknown', books: null, err: '', base: '' };

  function probe() {
    return api('/health').then(function () {
      health.state = 'ok'; health.err = ''; health.base = BASE;
    }).catch(function (e) {
      health.state = 'off'; health.base = BASE;
      health.err = (e && e.message) ? e.message : 'unreachable';
      // 探活失败可能是 BASE 猜错了 (换了访问地址/端口映射变了) —— 重探一次候选,
      // 拿对了就立刻重试, 不要整页一直挂着"离线"。
      return resolveBase().then(function (base) {
        health.base = base;
        return api('/health').then(function () {
          health.state = 'ok'; health.err = ''; note('base 改走 ' + base);
        }).catch(function (e2) {
          health.err = (e2 && e2.message) ? e2.message : health.err;
        });
      }).catch(function () {});
    });
  }

  // ---- 顶栏按钮 (最显眼, 手机上也看得见) ------------------------------
  function mountTop() {
    if (document.getElementById('zy-top-item')) return true;
    var nav = document.querySelector('nav.navbar');
    if (!nav) return false;
    var box = el('div', 'nav-item');
    box.id = 'zy-top-item';
    var a = el('a', 'btn btn-icon zy-top-btn');
    a.href = CONSOLE;
    a.target = '_blank';
    a.rel = 'noopener';
    a.title = '掌阅同步 · 打开桥接控制台 (' + CONSOLE + ')';
    a.innerHTML =
      '<span class="zy-dot"></span>' +
      '<i class="fas fa-cloud-download-alt" aria-hidden="true"></i>' +
      '<span class="zy-top-lbl">掌阅同步</span>';
    box.appendChild(a);
    var anchor = nav.querySelector('app-download-queue-widget');
    if (anchor && anchor.parentNode === nav) nav.insertBefore(box, anchor);
    else {
      var c = nav.querySelector('.container-fluid');
      if (c) c.appendChild(box); else nav.appendChild(box);
    }
    return true;
  }

  // ---- 左侧导航入口 ---------------------------------------------------
  var NAV_AFTER = ['/bookmarks', '/want-to-read', '/lists', '/all-series'];
  var navInserted = false;

  function findNavAnchor() {
    var items = Array.prototype.slice.call(document.querySelectorAll('a.side-nav-item, a[href^="/"]'));
    for (var i = 0; i < items.length; i++) {
      var h = items[i].getAttribute('href') || '';
      if (NAV_AFTER.indexOf(h) >= 0) return items[i];
    }
    var all = document.querySelectorAll('.side-nav a[href]');
    return all.length ? all[all.length - 1] : null;
  }

  function makeNavItem() {
    var a = el('a', 'side-nav-item');
    a.id = 'zy-nav-item';
    a.href = CONSOLE;
    a.target = '_blank';
    a.rel = 'noopener';
    a.title = '在新标签打开掌阅桥接控制台';
    a.innerHTML =
      '<i class="fa fa-cloud-download" aria-hidden="true"></i>' +
      '<span>掌阅同步</span>' +
      '<span class="zy-badge" id="zy-nav-badge">…</span>';
    return a;
  }

  function mountNav() {
    if (navInserted && document.getElementById('zy-nav-item')) return true;
    var anchor = findNavAnchor();
    if (!anchor) return false;
    var old = document.getElementById('zy-nav-item');
    if (old) old.remove();
    anchor.parentNode.insertBefore(makeNavItem(), anchor.nextSibling);
    navInserted = true;
    return true;
  }

  function paintBadge() {
    var top = document.getElementById('zy-top-item');
    if (top) {
      top.classList.remove('zy-ok', 'zy-err');
      if (health.state === 'ok') top.classList.add('zy-ok');
      else if (health.state === 'off') top.classList.add('zy-err');
    }
    var b = document.getElementById('zy-nav-badge');
    var item = document.getElementById('zy-nav-item');
    if (!b || !item) return;
    item.classList.remove('zy-ok', 'zy-err');
    if (health.state === 'ok') {
      item.classList.add('zy-ok');
      b.textContent = health.books != null ? health.books + ' 本' : '就绪';
      b.title = '控制台: ' + CONSOLE;
    } else if (health.state === 'off') {
      item.classList.add('zy-err');
      b.textContent = '离线';
      b.title = '后端 ' + health.base + ' 没连上: ' + health.err
        + '  (浏览器控制台跑 __ZY__.auto() 看详情)';
      if (top) top.title = '掌阅同步后端不可达: ' + health.base + ' ' + health.err;
    } else {
      b.textContent = '…';
    }
  }

  // ---- 自动同步: 读书钩子 (v0.4.0) ------------------------------------
  // 语义对齐掌阅 App:
  //   进书            → pull (掌阅 -> Kavita, 只前进不回退, 位置变了才重载)
  //   阅读中存进度    → push (Kavita -> 掌阅, 去抖, push_decision 闸门防回退)
  //   离开书/页面隐藏 → 立刻 flush 未发出的 push
  var AUTO = { on: false, debounce: 8, gap: 120 };
  var READER_RE = /\/library\/\d+\/series\/(\d+)\/book\/\d+/;
  var BOOK_RE = /\/library\/\d+\/series\/(\d+)\/book\/(\d+)/;
  var SERIES_RE = /\/library\/\d+\/series\/(\d+)(?:\/|$)/;
  var rt = { reader: null, series: null, book: null };
  var pushTimers = {};
  var autoLog = [];

  function note(msg) {
    autoLog.push({ t: new Date().toISOString().slice(11, 19), m: msg });
    if (autoLog.length > 24) autoLog.shift();
  }

  // 右下角小提示: **默认静默** —— 只有同步失败 / 未推送成功才弹。
  // 成功的情况一律只进 autoLog (__ZY__.auto() 可查), 不打扰阅读。
  function toast(msg, kind) {
    try {
      var n = document.getElementById('zy-toast');
      if (!n) { n = el('div'); n.id = 'zy-toast'; document.body.appendChild(n); }
      n.textContent = msg;
      if (kind === 'err') n.classList.add('err'); else n.classList.remove('err');
      n.classList.add('on');
      clearTimeout(toast._t);
      toast._t = setTimeout(function () { n.classList.remove('on'); }, 3500);
    } catch (e) {}
  }

  // 同类提示的节流 (regress 一句可能被反复触发, 不该每 30s 弹一次)
  var toastGap = {};
  function toastOnce(key, msg, gapSec) {
    var now = Date.now();
    if (now - (toastGap[key] || 0) < (gapSec || 600) * 1000) return;
    toastGap[key] = now;
    toast(msg, 'err');
  }

  // 心跳: 让服务端 api.log 能证明"这个浏览器加载了哪一版钩子"
  var hbLast = { t: 0, key: '' };
  var saveCount = 0, pushCount = 0;
  function heartbeat(force) {
    var key = VER + ' ' + location.pathname;
    var now = Date.now();
    if (!force && key === hbLast.key && now - hbLast.t < 60000) return;
    if (force && now - hbLast.t < 5000) return;   // 强制也限 5s 一次
    hbLast = { t: now, key: key };
    var msgs = autoLog.slice(-6).map(function (x) { return x.m; });
    if (health.err) msgs.push('health: ' + health.err);
    apiPost('/auto/hb', {
      ver: VER, path: location.pathname, on: AUTO.on,
      saves: saveCount, pushes: pushCount, base: BASE_TRIED + (health.err ? ' !' + health.err : ''),
      msgs: msgs
    }).catch(function () {});
  }

  function apiPost(path, body, keepalive) {
    var init = {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-ZY-Token': TOKEN },
      body: JSON.stringify(body || {})
    };
    if (keepalive) init.keepalive = true;
    return fetch(BASE + path, init).then(function (r) {
      return r.json().catch(function () { return {}; });
    });
  }

  // pull: 掌阅 -> Kavita。allowReload=true 时位置真变了才重载到掌阅那页。
  function pullSeries(sid, allowReload) {
    if (!AUTO.on || !sid) return;
    var ck = 'zy_pull_' + sid;
    var now = Date.now();
    if (now - (+(sessionStorage.getItem(ck) || 0)) < AUTO.gap * 1000) return;
    try { sessionStorage.setItem(ck, String(now)); } catch (e) {}
    note('pull #' + sid + ' …');
    apiPost('/auto/pull', { series_id: sid }).then(function (j) {
      if (!j || j.ok === false) {
        if (j && j.busy) { note('pull #' + sid + ' busy'); return; }
        note('pull #' + sid + ' FAIL ' + JSON.stringify(j || {}).slice(0, 120));
        toastOnce('pull' + sid, '从掌阅拉取进度失败' +
          (j && j.error ? '：' + j.error : '（后端不可用）'));
        return;
      }
      if (j.skipped) { note('pull #' + sid + ' ' + j.skipped); return; }
      note('pull #' + sid + ' ' + j.before + '->' + j.pages_read + '/' + j.pages);
      if (!j.changed) note('pull #' + sid + ' 掌阅没有更新');
      // 成功不弹提示 (v0.4.9 起默认静默)
      if (!j.changed || !allowReload) return;
      var rk = 'zy_reload_' + sid;
      if (Date.now() - (+(sessionStorage.getItem(rk) || 0)) < 10000) return;
      try { sessionStorage.setItem(rk, String(Date.now())); } catch (e) {}
      note('pull #' + sid + ' 位置变了, 重载到掌阅位置');
      setTimeout(function () { location.reload(); }, 120);
    }).catch(function (e) {
      note('pull #' + sid + ' ERR ' + e.message);
      toastOnce('pull' + sid, '从掌阅拉取进度失败：' + e.message);
    });
  }

  function pushNow(sid, quiet) {
    if (!AUTO.on || !sid) return;
    apiPost('/auto/push', { series_id: sid, tick: !!quiet }).then(function (j) {
      var d = (j && j.detail) || {};
      pushCount++;
      note('push #' + sid + ' +' + (d.pushed || 0) + ' ~' + (d.skipped || 0) +
           ' !' + (d.failed || 0) + (quiet ? ' (tick)' : ''));
      heartbeat(true);
      // 成功不弹 (v0.4.9 默认静默); 失败才提示
      if (!j || j.ok === false) {
        if (j && j.busy) return;
        note('push #' + sid + ' FAIL ' + JSON.stringify(j || {}).slice(0, 120));
        toastOnce('push' + sid, '推送进度到掌阅失败' +
          (j && j.error ? '：' + j.error : '（后端不可用）'));
        return;
      }
      if (d.failed > 0) {
        var err = '';
        var det0 = d.detail || [];
        for (var k0 = 0; k0 < det0.length; k0++) {
          if (det0[k0] && det0[k0].ok === false) {
            err = String(det0[k0].error || det0[k0].skipped || '');
            break;
          }
        }
        toastOnce('pushfail' + sid, '推送进度到掌阅失败' + (err ? '：' + err : ''));
        return;
      }
      if (d.pushed > 0) {                 // 成功 → 静默, 只更新右下角角标
        refreshStamp(sid, rt.reader === sid ? rt.book : null, true);
        return;
      }
      if (j.detail && j.detail.length) {
        var why = '';
        for (var i = 0; i < j.detail.length; i++) {
          if (j.detail[i] && j.detail[i].skipped) { why = String(j.detail[i].skipped); break; }
        }
        // 只有"回退被挡"值得说一声 —— 用户会以为"推了却没生效"
        // 节流 10 分钟: 在读时每轮都命中, 每 30s 弹一次太吵
        if (why.indexOf('regress') === 0) {
          toastOnce('regress' + sid, '掌阅进度更靠前，本次不回拨（Kavita 落后）', 600);
        }
      }
    }).catch(function (e) {
      note('push #' + sid + ' ERR ' + e.message);
      toastOnce('push' + sid, '推送进度到掌阅失败：' + e.message);
    });
  }

  // 去抖 + 最大等待: 连续翻页会不断重置计时器, 纯去抖在"读得快"时永远不触发。
  // 最大等待 30s —— 到点先推一次, 后面再按去抖来。
  // v0.4.5: 一轮阅读的**第一次**存进度快推 (3s) —— 手机切走/锁屏会冻结定时器,
  //         纯去抖在后台标签里可能整晚都不发。
  var PUSH_MAX_WAIT = 30;
  var PUSH_FAST = 3;          // 忙碌束的第一发, 秒
  var PUSH_FAST_GAP = 10;     // 两发快推之间至少隔 10s
  var pushFirst = {};
  var pushLastAt = {};

  function schedulePush(sid) {
    if (!AUTO.on || !sid) return;
    var now = Date.now();
    var burstStart = !pushTimers[sid];
    if (!pushFirst[sid]) pushFirst[sid] = now;
    if (pushTimers[sid]) clearTimeout(pushTimers[sid]);
    var wait = AUTO.debounce * 1000;
    if (now + wait - pushFirst[sid] >= PUSH_MAX_WAIT * 1000) wait = 0;
    if (burstStart && now - (pushLastAt[sid] || 0) > PUSH_FAST_GAP * 1000) {
      wait = Math.min(wait, PUSH_FAST * 1000);
    }
    pushTimers[sid] = setTimeout(function () {
      delete pushTimers[sid];
      pushFirst[sid] = 0;
      pushLastAt[sid] = Date.now();
      pushNow(sid);
    }, wait);
  }

  function flushPush(useBeacon) {
    Object.keys(pushTimers).forEach(function (sid) {
      clearTimeout(pushTimers[sid]);
      delete pushTimers[sid];
      if (useBeacon && navigator.sendBeacon) {
        try {
          navigator.sendBeacon(
            BASE + '/auto/push?token=' + encodeURIComponent(TOKEN),
            JSON.stringify({ series_id: +sid }));
          note('push #' + sid + ' beacon');
          return;
        } catch (e) { /* 落回普通请求 */ }
      }
      pushNow(+sid);
    });
  }

  // ---- 阅读器右下角角标: 上次 push 到掌阅的时间 (v0.4.11) --------------
  // 只有"这本书有掌阅映射 + 自动同步开着"时出现。纯展示, 不写任何状态。
  // 数据来自后端 /zy/api/zy-status 的 push_last_<series>_<chapter> (state.sqlite),
  // 粒度到卷 —— 多卷系列 (藤井) 不能共用系列级时间。
  var zst = { at: 0, data: null };

  function stampNode() {
    var n = document.getElementById('zy-push-stamp');
    if (!n) {
      n = el('div');
      n.id = 'zy-push-stamp';
      n.setAttribute('aria-hidden', 'true');
      document.body.appendChild(n);
    }
    return n;
  }

  function stampHide() {
    var n = document.getElementById('zy-push-stamp');
    if (n && n.parentNode) n.parentNode.removeChild(n);
  }

  function fmtStamp(iso) {
    if (!iso) return '';
    var d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    var p2 = function (x) { return ('0' + x).slice(-2); };
    var hm = p2(d.getHours()) + ':' + p2(d.getMinutes());
    var today = new Date();
    if (d.toDateString() === today.toDateString()) return hm;
    return (d.getMonth() + 1) + '/' + d.getDate() + ' ' + hm;
  }

  function renderStamp(sid, bookId) {
    if (!AUTO.on) { stampHide(); return; }
    var s = zst.data && zst.data.series && zst.data.series[String(sid)];
    if (!s) { stampHide(); return; }          // 没映射 → 这不是掌阅书
    var chs = s.chapters || {};
    var e = chs[String(bookId)] || chs['-1'];
    if (!e) {
      // 多卷系列没有卷级记录时不要拿别的卷冒充 —— 宁可显示"尚未推送"
      var ks = Object.keys(chs);
      if (ks.length !== 1) { stampHide(); return; }
      e = chs[ks[0]];
    }
    var txt;
    if (e.last_push_at) {
      txt = '掌阅 ' + fmtStamp(e.last_push_at) + ' 已推送';
      if (e.last_push_pct != null) {
        txt += ' ' + (Math.floor(e.last_push_pct * 1000) / 10).toFixed(1) + '%';
      }
    } else {
      txt = '掌阅 尚未推送';
    }
    var n = stampNode();
    if (n.textContent !== txt) n.textContent = txt;
    n.title = txt;
  }

  function refreshStamp(sid, bookId, force) {
    if (!sid || !AUTO.on) { stampHide(); return; }
    if (!force && Date.now() - zst.at < 5000) { renderStamp(sid, bookId); return; }
    zst.at = Date.now();
    api('/zy-status').then(function (j) {
      zst.data = j;
      if (rt.reader) renderStamp(rt.reader, rt.book);
    }).catch(function () { /* 后端不可用 → 不显示, 静默 */ });
  }

  // ---- 图片/漫画阅读器: 把"书签图标"钉回图片内 (v0.4.15) -------------
  // Kavita 给图片阅读器里每一页 <img> 挂一个 div.bookmark-overlay
  // (空心=本页未加书签, 实心=已加)。位置是注入那一刻算死的:
  //     left = imgW + (imgLeft-parentLeft) - min(32, imgW*0.05)
  //     top  = imgH + (imgTop -parentTop ) - min(32, imgH*0.05)
  // 两个坑:
  //   1. 这个 div 实际高 42px (32px 字号 + 上下 5px 内边距), 却按 32px 定位
  //      → 底边探出图片 10px (小图 20px+)。单页模式下悬在页外的黑底上,
  //      连续滚动/条漫模式下正好压在下一张图顶部 —— 就是"书签图标浮在
  //      页面当中"的样子。
  //   2. 只在注入时算一次, 之后换 fit / 浏览器缩放 / 窗口 resize 都不重算,
  //      图标会从页角飘到页面中间。
  // 不改 Kavita: 用 right/bottom 把它钉回自己那张图的右下角内侧 (不依赖
  // 图片尺寸), 并在 DOM 变动 / resize 后重算。
  var BM = { fixed: 0, removed: 0, last: 0, skip: 0 };

  function bmHost(ov) {
    var h = ov.parentElement;
    if (h && h.tagName === 'IMG') h = h.parentElement;   // 防呆: img 不能当容器
    return h;
  }

  // 返回本轮新摆正/清理的数量
  function bmFix() {
    var list = document.querySelectorAll('.bookmark-overlay');
    var n = 0;
    for (var i = 0; i < list.length; i++) {
      var ov = list[i];
      var host = bmHost(ov);
      if (!host) { continue; }
      var img = host.querySelector('img');
      if (!img) {                                   // 图没了, 图标成了孤儿
        if (ov.parentNode) { ov.parentNode.removeChild(ov); BM.removed++; n++; }
        continue;
      }
      if (getComputedStyle(host).position === 'static') host.style.position = 'relative';
      var hr = host.getBoundingClientRect();
      var ir = img.getBoundingClientRect();
      // 图片相对容器右下角的偏移 (双页模式下两张图共用容器时也各自贴自己的角)
      var right = Math.round(hr.right - ir.right) + 4;
      var bottom = Math.round(hr.bottom - ir.bottom) + 4;
      var st = ov.style;
      var want = ['absolute', 'auto', 'auto', right + 'px', bottom + 'px'].join('|');
      if (ov.getAttribute('data-zy-bm') === want) continue;   // 已经摆好, 不重复写
      st.position = 'absolute';
      st.left = 'auto';
      st.top = 'auto';
      st.right = right + 'px';
      st.bottom = bottom + 'px';
      st.margin = '0';
      ov.setAttribute('data-zy-bm', want);
      BM.fixed++; BM.last = i; n++;
    }
    return n;
  }

  function bmFixSoon() {
    clearTimeout(bmFixSoon._t);
    bmFixSoon._t = setTimeout(function () { try { bmFix(); } catch (e) {} }, 120);
  }

  function routeTick() {
    var p = location.pathname;
    var rm = READER_RE.exec(p);
    var rn = rm ? +rm[1] : null;
    var bm = BOOK_RE.exec(p);
    var bn = bm ? +bm[2] : null;
    var sm = SERIES_RE.exec(p);
    var sn = (!rn && sm) ? +sm[1] : null;

    if (rn !== rt.reader || bn !== rt.book) {
      if (rt.reader) flushPush(false);        // 离开上一本, 尾巴先推掉
      rt.reader = rn;
      rt.book = bn;
      if (rn) {
        pullSeries(rn, true);                 // 进书: 取掌阅进度
        refreshStamp(rn, bn, true);           // 右下角角标
        // 关键词高亮: 等正文渲染完再铺一遍, 并盯住后续换页
        setTimeout(function () { kmSync().then(kmWatch); }, 700);
      } else {
        stampHide();
        kmClear();
        KM.sid = null; KM.data = null; KM.ver = null;
      }
      heartbeat(true);
    }
    if (sn !== rt.series) {
      rt.series = sn;
      if (sn) pullSeries(sn, false);          // 详情页: 只刷进度, 不重载
      heartbeat(true);
    }
    // 图片阅读器的书签图标归位 (廉价: 没有 .bookmark-overlay 直接返回)
    if (rn) bmFixSoon();
  }

  // Kavita 保存阅读进度 = 一次 POST api/reader/progress。抓到它就排一次 push。
  function onReaderRequest(url, body) {
    if (!AUTO.on || !url) return;
    if (String(url).indexOf('reader/progress') < 0) return;
    var sid = null;
    try {
      if (typeof body === 'string') sid = +JSON.parse(body).seriesId || null;
      else if (body && typeof body === 'object') sid = +body.seriesId || null;
    } catch (e) {}
    if (!sid) {
      var m = READER_RE.exec(location.pathname);
      sid = m ? +m[1] : null;
    }
    if (sid) { saveCount++; note('save #' + sid); schedulePush(sid); heartbeat(true); }
  }

  function hookNetwork() {
    if (hookNetwork.done) return;
    hookNetwork.done = true;

    var OX = XMLHttpRequest.prototype.open;
    var OS = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.open = function (m, u) {
      this.__zyUrl = u;
      return OX.apply(this, arguments);
    };
    XMLHttpRequest.prototype.send = function (b) {
      try { onReaderRequest(this.__zyUrl, b); } catch (e) {}
      return OS.apply(this, arguments);
    };

    if (window.fetch && !window.fetch.__zyWrapped) {
      var OF = window.fetch;
      var WF = function (input, init) {
        try {
          var u = (typeof input === 'string') ? input : (input && input.url);
          if (init && typeof init.body === 'string') onReaderRequest(u, init.body);
        } catch (e) {}
        return OF.apply(this, arguments);
      };
      WF.__zyWrapped = true;
      window.fetch = WF;
    }

    var OPS = history.pushState;
    var ORS = history.replaceState;    history.pushState = function () {
      var r = OPS.apply(this, arguments);
      setTimeout(routeTick, 60);
      return r;
    };
    history.replaceState = function () {
      var r = ORS.apply(this, arguments);
      setTimeout(routeTick, 60);
      return r;
    };
    window.addEventListener('popstate', function () { setTimeout(routeTick, 60); });
    window.addEventListener('pagehide', function () { flushPush(true); });
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'hidden') { flushPush(true); return; }
      // 回到前台: 后台标签的定时器可能被冻结过 —— 补一次探活/心跳/钩子自检
      probe().then(tick).catch(tick);
      if (!bootOk) autoBoot();
      if (AUTO.on) { heartbeat(true); routeTick(); }
    });
    setInterval(routeTick, 900);
    // 定时兜底 push: Kavita 的"存进度"并不覆盖所有位置变化 (滚动式 epub 只在
    // 特定时机存), 阅读中每 60s 兜一次。push_decision 会挡 noop / 回退, 不脏写。
    setInterval(function () {
      if (!AUTO.on || !rt.reader) return;
      if (document.visibilityState === 'hidden') return;
      pushNow(rt.reader, true);
    }, 60000);
    routeTick();
  }

  var bootTries = 0, bootOk = false;
  function autoBoot() {
    if (bootOk) return;
    bootTries++;
    resolveBase().then(function () {
      note('base ' + BASE);
      applyReaderCss();
      return api('/auto/cfg');
    }).then(function (j) {
      AUTO.on = !!j.enabled;
      AUTO.debounce = j.push_debounce_sec || 8;
      AUTO.gap = j.pull_gap_sec || 120;
      bootOk = true;
      if (AUTO.on) hookNetwork();
      note('auto ' + (AUTO.on ? 'on' : 'off'));
      heartbeat(true);   // 服务端据此确认"这一版钩子真的在跑"
    }).catch(function (e) {
      // 后端重启/网络抖动时 cfg 读不到 —— 不重试的话这一整页就永远没有钩子
      // (2026-10-24 事故: 页面在 5111 重启窗口加载, 读了整晚一次都没推)。
      // v0.4.5: 不再限 20 次, 退避封顶 60s, 页面重新可见时立刻再试一次。
      note('auto cfg 读取失败 ' + (e && e.message) + ' (第' + bootTries + '次)');
      heartbeat(true);
      var backoff = Math.min(60000, 15000 + bootTries * 5000);
      clearTimeout(autoBoot._t);
      autoBoot._t = setTimeout(autoBoot, backoff);
    });
  }

  // ---- 生命周期 -------------------------------------------------------
  function tick() {
    injectCss();
    mountTop();
    mountNav();
    paintBadge();
  }

  var mo = new MutationObserver(function () {
    clearTimeout(tick._t);
    tick._t = setTimeout(tick, 250);
    // 换页/换章会重新注入 .bookmark-overlay; 只有见过才付查询成本
    if (BM.fixed) bmFixSoon();
  });

  function boot() {
    injectCss();
    var tries = 0;
    (function waitBody() {
      if (document.body) {
        mo.observe(document.body, { childList: true, subtree: true });
        tick();
        probe().then(function () {
          return api('/links').then(function (j) {
            health.books = (j.links || j.rows || []).length || 0;
          }).catch(function () {});
        }).then(tick).catch(tick);
        setInterval(tick, 15000);
        // 缩图/换 fit/横竖屏都会让 Kavita 里那张"算死的"书签图标脱离页角
        window.addEventListener('resize', bmFixSoon);
        window.addEventListener('orientationchange', bmFixSoon);
        if (window.visualViewport) {
          window.visualViewport.addEventListener('resize', bmFixSoon);
          window.visualViewport.addEventListener('scroll', bmFixSoon);
        }
        setInterval(function () { probe().then(tick).catch(tick); }, 30000);
        setInterval(applyReaderCss, 60000);
        setInterval(function () {
          if (!rt.reader && !rt.series) return;
          kmSync().then(kmWatch);
        }, 60000);
        // 回到前台兜底 (钩子没装上时 hookNetwork 里的监听器根本不存在)
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState !== 'visible') return;
          if (!bootOk) autoBoot();
          applyReaderCss();
          kmSync().then(kmWatch);
          probe().then(tick).catch(tick);
        });
        autoBoot();
        return;
      }
      if (tries++ > 60) return;
      setTimeout(waitBody, 250);
    })();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();

  // 调试口: 浏览器控制台执行 __ZY__.ver 可确认当前加载哪一版
  //         __ZY__.auto() 可看自动同步开关 + 最近 24 条动作
  window.__ZY__ = {
    api: api, health: health, console: CONSOLE, ver: VER, tick: tick,
    auto: function () {
      return { on: AUTO.on, reader: rt.reader, series: rt.series,
               debounce: AUTO.debounce, gap: AUTO.gap,
               base: BASE_TRIED, boot: bootTries, ok: bootOk,
               saves: saveCount, pushes: pushCount, log: autoLog.slice() };
    },
    pull: pullSeries, push: pushNow,
    readerCss: function () {
      return { ver: RS.ver, on: RS.on, bytes: (RS.css || '').length,
               err: RS.err, at: RS.at, jsVer: VER,
               node: !!document.getElementById('zy-reader-css') };
    },
    applyReaderCss: applyReaderCss,
    bm: function () {
      var list = document.querySelectorAll('.bookmark-overlay');
      var rows = [];
      for (var i = 0; i < list.length; i++) {
        var ov = list[i], h = bmHost(ov), im = h ? h.querySelector('img') : null;
        var or = ov.getBoundingClientRect();
        var ir = im ? im.getBoundingClientRect() : null;
        rows.push({
          solid: /fa-solid/.test(ov.className),
          style: ov.getAttribute('data-zy-bm') || '(kavita 原样)',
          ov: [or.left, or.top, or.width, or.height].map(Math.round),
          img: ir ? [ir.left, ir.top, ir.width, ir.height].map(Math.round) : null,
          dRight: ir ? Math.round(ir.right - or.right) : null,
          dBottom: ir ? Math.round(ir.bottom - or.bottom) : null,
          inside: ir ? (or.left >= ir.left - 1 && or.top >= ir.top - 1 &&
                        or.right <= ir.right + 1 && or.bottom <= ir.bottom + 1) : null
        });
      }
      return { fixed: BM.fixed, removed: BM.removed, count: rows.length, rows: rows };
    },
    bmFix: function () { return bmFix(); },
    kw: function () {
      return { ver: KM.ver, sid: KM.sid, mode: KM.mode, on: !!(KM.data && KM.data.enabled),
               cats: KM.cats, words: KM.words, ranges: KM.ranges, spans: KM.spans,
               textLen: KM.textLen || 0, contentLen: kmContentLen(),
               file: KM.file, err: KM.err, note: KM.note, skipped: KM.skipped,
               at: KM.appliedAt, hl: KM.hl.slice(),
               hasHighlightApi: !!(window.CSS && window.CSS.highlights && typeof Highlight === 'function'),
               container: !!kmContainer() };
    },
    kwApply: function () { if (KM.data) kmApply(KM.data); },
    kwSync: kmSync
  };
})();
